{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eelsdb",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  // Fonts and logo files for the share cards (src/og/), bundled into the Worker.
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"] },
    { "type": "Text", "globs": ["**/*.svg"] }
  ],
  // The Worker runs first for these so that a deployment on another host can point their links at itself.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/robots.txt", "/llms.txt", "/docs/*"] },
  // The site's public address; the API is served on the same host with "api." in front.
  // API_USAGE_DATASET must name the dataset of the API_USAGE binding.
  "vars": { "SITE_URL": "https://eelsdb.eu", "API_USAGE_DATASET": "eelsdb_api" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eelsdb",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "eelsdb-files" }],
  "analytics_engine_datasets": [{ "binding": "API_USAGE", "dataset": "eelsdb_api" }],
  // Simulated locally (wrangler dev and the tests). Before deploying, onboard a sending domain in the
  // Cloudflare account (Email Sending) and set EMAIL_PROVIDER=cloudflare and EMAIL_FROM on that domain.
  "send_email": [{ "name": "EMAIL" }],
  // Daily: delete old drafts, contact messages and rate-limit events, and copy usage counts into D1.
  "triggers": { "crons": ["17 3 * * *"] },
  // Caps the CPU one invocation can bill (Workers Paid default: 30 s); env.dev inherits it. The heaviest work,
  // an old bcrypt (cost 12) password check, needs well under 1 s.
  "limits": { "cpu_ms": 2000 },
  "observability": { "enabled": true },
  // A test deployment on its own hosts, data and files: `npx wrangler deploy --env dev`. Copy this block for
  // other hosts. Bindings are not inherited from the top level, so each environment lists them all.
  "env": {
    "dev": {
      // workers.dev has no api. host, so the API is under /_api. Once eelsdb.eu is on Cloudflare, move to dev.eelsdb.eu,
      // drop API_URL and add "routes": [{ "pattern": "dev.eelsdb.eu", "custom_domain": true }, and the same for api.dev.eelsdb.eu].
      "vars": { "SITE_URL": "https://eelsdb-dev.eelsdb.workers.dev", "API_URL": "https://eelsdb-dev.eelsdb.workers.dev/_api", "API_USAGE_DATASET": "eelsdb_dev_api" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "eelsdb-dev",
          "database_id": "326de155-d564-4fff-ac76-f699ebef4cc2",
          "migrations_dir": "migrations",
          "remote": true
        }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "eelsdb-dev-files", "remote": true }],
      "analytics_engine_datasets": [{ "binding": "API_USAGE", "dataset": "eelsdb_dev_api" }],
      "send_email": [{ "name": "EMAIL" }]
    }
  }
}
