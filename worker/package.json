{
  "name": "eelsdb-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "test -d public/docs || npm run docs",
    "dev": "wrangler dev --var ENVIRONMENT:development",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/seed.mjs",
    "types": "wrangler types",
    "vendor": "cp node_modules/uplot/dist/uPlot.iife.min.js node_modules/uplot/dist/uPlot.min.css public/vendor/ && cp node_modules/uqr/dist/index.mjs public/vendor/uqr.mjs && esbuild node_modules/@simplewebauthn/browser/esm/index.js --bundle --minify --format=esm --outfile=public/vendor/simplewebauthn-browser.mjs && esbuild scripts/vendor-tiptap.js --bundle --minify --format=esm --outfile=public/vendor/tiptap.mjs",
    "py": "mkdir -p public/py/eelsdb && cp ../python/eelsdb/*.py public/py/eelsdb/",
    "docs": "npm --prefix ../docs-site run build"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@resvg/resvg-wasm": "^2.6.2",
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.13.13",
    "katex": "^0.18.11",
    "marked": "^18.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@simplewebauthn/browser": "^14.0.0",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-mathematics": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-subscript": "^3.33.0",
    "@tiptap/extension-superscript": "^3.33.0",
    "@tiptap/markdown": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "typescript": "^7.0.2",
    "uplot": "^1.6.32",
    "uqr": "^0.1.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261019.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
